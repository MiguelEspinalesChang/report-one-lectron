{
  "name": "@platform/electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node esbuild.config.mjs && wait-on tcp:127.0.0.1:5173 && electron .",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "installer": "echo 'installer packaging not configured yet (electron-builder + PyInstaller)'",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@platform/core": "workspace:*",
    "@platform/shared-types": "workspace:*",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@platform/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
