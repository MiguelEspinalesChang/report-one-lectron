  },
  "devDependencies": {
    "@platform/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "electron": "^34.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.0"
  }
}
