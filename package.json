{
  "name": "report-one-lectron",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && bash scripts/lint-python.sh",
    "test": "turbo run test && bash scripts/test-python.sh",
    "clean": "turbo run clean",
    "installer": "turbo run installer",
    "update": "pnpm update -r",
    "setup:python": "bash scripts/setup-python.sh",
    "branches:clean": "bash scripts/git-clean-branches.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,vue,js,mjs}": "eslint --fix",
    "*.py": "bash scripts/ruff-staged.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@platform/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "turbo": "^2.3.0"
  }
}
